rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Hardcoded admin (Flambeau). Keep in sync with ADMIN_UID in lib/admin.ts.
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'OYNKB7S6WqQvcbRt6uKSpIcelTt2';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isStars(value) {
      return value is int && value >= 1 && value <= 5;
    }

  	// Users can only access their own watchlist and reminders
    match /users/{userId} {
      // The user's own profile document (displayName, favoriteGenres, etc.)
      allow read, write: if isOwner(userId);

      // Rankings live on the watchlist docs, so they're private like the rest of the list.
      match /watchlist/{itemId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && (!('rating' in request.resource.data) || isStars(request.resource.data.rating));
      }
      match /reminders/{itemId} {
        allow read, write: if isOwner(userId);
      }
      match /notifications/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /checkpoints/{checkpointId} {
        allow read, write: if isOwner(userId);
      }
      match /inbox/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Flambeau's recommendations: public to everyone (even signed out), written only by the admin.
    match /recommendations/{recId} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && isStars(request.resource.data.stars)
        && request.resource.data.id is int
        && request.resource.data.media_type in ['movie', 'tv'];
    }

  	// Block all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
